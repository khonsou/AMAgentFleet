# 复制为 deploy/.env 后填写。.env 不入库（含密钥）。

# ACK 部署需要的 DeepSeek 官方 API key（只注入网关）
DEEPSEEK_API_KEY=sk-在此填写

# ACK 部署：远程 PostgreSQL 完整 DSN（指向已创建的 deerflow 数据库）
# 例如 postgresql://用户名:密码@数据库地址:5432/deerflow
# DeerFlow 使用 asyncpg；不要附加 libpq 专用的 sslmode 参数。
DATABASE_URL=

# Docker Compose 单机部署才使用此本地 PostgreSQL 口令
PG_PASSWORD=在此设置强口令

# ACK Console 登录：DAO OAuth JWT 验签配置（公钥文件在 deploy/ 下，issuer 为公开标识）
FLEET_AUTH_JWT_ISSUER=angrymiao
FLEET_AUTH_JWT_PUBLIC_KEY_FILE=dao-jwt-public-key.pem

# ECS Docker Compose Console 对外端口
FLEET_PORT=8080
# 监听地址：默认 0.0.0.0；纯本机验证用 127.0.0.1
FLEET_BIND=0.0.0.0

# ACK Gateway 仅由 ClusterIP 暴露，Console API 由 DAO OAuth 鉴权；不要新增 Gateway 公网入口。
DEER_FLOW_AUTH_DISABLED=1

# 网关 PostgreSQL 后端所需 extra（ACK/Compose 均默认使用 postgres）
UV_EXTRAS=postgres

# 可选镜像 tag；默认由 Git commit/工作区状态生成
IMAGE_TAG=
