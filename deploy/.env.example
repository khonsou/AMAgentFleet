# 复制为 deploy/.env 后填写。.env 不入库（含密钥）。

# DeepSeek 官方 API key（网关 config.fleet.yaml 经 $DEEPSEEK_API_KEY 注入，唯一必填密钥）
DEEPSEEK_API_KEY=sk-在此填写

# 平台数据库 postgres 的口令（ECS 自建；换 RDS 时改 DEPLOY.md §5.3 的 DSN）
PG_PASSWORD=在此设置强口令

# Console 对外端口（安全组只放行此端口 + 限定来源 IP）
FLEET_PORT=8080
# 监听地址：默认 0.0.0.0（ECS 内网+安全组约束）；纯本机验证用 127.0.0.1
FLEET_BIND=0.0.0.0

# 网关鉴权开关：MVP 关闭（配合安全组来源限制！），P4 OIDC 落地后改为 0 并接 IdP
DEER_FLOW_AUTH_DISABLED=1

# 网关镜像构建参数（一般留空；阿里云内网构建可配镜像源）
UV_EXTRAS=
