# Console 前端：构建静态产物 + nginx 伺服（构建上下文 = AMAgentFleet 仓库根）
FROM node:20-alpine AS build
WORKDIR /fe
COPY console/frontend/package.json console/frontend/package-lock.json ./
RUN npm ci
COPY console/frontend ./
ARG VITE_AUTH_ENABLED=0
ARG VITE_AUTH_ORIGIN=https://auth.angrymiao.com
ARG VITE_OAUTH_CLIENT_ID=am-agent-fleet
ENV VITE_AUTH_ENABLED=$VITE_AUTH_ENABLED \
    VITE_AUTH_ORIGIN=$VITE_AUTH_ORIGIN \
    VITE_OAUTH_CLIENT_ID=$VITE_OAUTH_CLIENT_ID
RUN npm run build

FROM nginx:alpine
COPY --from=build /fe/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
