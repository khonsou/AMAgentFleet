{
  "protocol": "am-fleet-ops",
  "version": "1.0",
  "title": "AM Agent Fleet Operations Protocol",
  "surfaces": {
    "control-plane": "Fleet Control Plane API",
    "console": "Fleet Console observation and thread API",
    "gateway": "DeerFlow Gateway thread and run API"
  },
  "rules": {
    "read": "May execute directly",
    "write": "Requires explicit user confirmation and confirmed=true",
    "human_only": "Must be completed by a human in the UI; secrets must not enter the agent thread",
    "tasks": "Business execution uses Fleet Task/Loop and mandatory delivery acceptance",
    "cron": "Manage triggers.cron through the complete Agent YAML; default claimant is the owner Agent"
  },
  "operations": [
    {"id":"system.meta","method":"GET","path":"/api/meta","surface":"control-plane","description":"Discover FAP capabilities and protocol links"},
    {"id":"system.agent_doc","method":"GET","path":"/api/agent-doc","surface":"control-plane","description":"Read the FAP agent guide"},
    {"id":"system.protocol","method":"GET","path":"/api/ops/protocol","surface":"control-plane","description":"Read this complete operations protocol"},
    {"id":"system.openapi","method":"GET","path":"/openapi.json","surface":"control-plane","description":"Read exact Control Plane request and response schemas"},
    {"id":"system.health","method":"GET","path":"/api/health","surface":"control-plane","description":"Check Control Plane health"},
    {"id":"console.health","method":"GET","path":"/api/console/health","surface":"console","description":"Check Console, database and Gateway health"},
    {"id":"overview.get","method":"GET","path":"/api/console/overview","surface":"console","description":"Read global thread, run and token totals"},
    {"id":"fleet.threads","method":"GET","path":"/api/console/fleet","surface":"console","description":"List Agent runtime threads, status, runs and token usage"},
    {"id":"audit.list","method":"GET","path":"/api/audit","surface":"control-plane","description":"List append-only audit events","query":{"agent":"<optional agent name>","limit":100}},

    {"id":"agents.list","method":"GET","path":"/api/agents","surface":"control-plane","description":"List registered Agent definitions and lifecycle state"},
    {"id":"agents.get","method":"GET","path":"/api/agents/{name}","surface":"control-plane","description":"Read an Agent registry row and complete YAML"},
    {"id":"agents.create","method":"POST","path":"/api/agents","surface":"control-plane","write":true,"description":"Register and deploy a complete Agent YAML","query":{"actor":"fleet-ops-01"},"body":{"yaml":"<complete agentfleet/v1 document>"}},
    {"id":"agents.update","method":"PUT","path":"/api/agents/{name}","surface":"control-plane","write":true,"description":"Replace and redeploy complete Agent YAML including cron configuration","query":{"actor":"fleet-ops-01"},"body":{"yaml":"<complete agentfleet/v1 document>"}},
    {"id":"agents.destroy","method":"DELETE","path":"/api/agents/{name}","surface":"control-plane","write":true,"description":"Destroy Agent definition and runtime registration","query":{"actor":"fleet-ops-01"}},
    {"id":"agents.start","method":"POST","path":"/api/agents/{name}/start","surface":"control-plane","write":true,"description":"Start or wake a registered Agent","query":{"actor":"fleet-ops-01"}},
    {"id":"agents.stop","method":"POST","path":"/api/agents/{name}/stop","surface":"control-plane","write":true,"description":"Hibernate an Agent and reject new wakeups","query":{"actor":"fleet-ops-01"}},
    {"id":"agents.dispatch","method":"POST","path":"/api/agents/{name}/dispatch","surface":"control-plane","write":true,"description":"Legacy direct assignment; prefer tasks.create","body":{"input":"<task instruction>","source":"agent","actor":"fleet-ops-01"}},
    {"id":"inbox.list","method":"GET","path":"/api/agents/{name}/inbox","surface":"control-plane","description":"List pending and processed Agent inbox messages","query":{"limit":50}},
    {"id":"inbox.post","method":"POST","path":"/api/agents/{name}/inbox","surface":"control-plane","write":true,"description":"Send an asynchronous wakeup message to an Agent","body":{"payload":"<message>","source":"agent"}},

    {"id":"tasks.list","method":"GET","path":"/api/tasks","surface":"control-plane","description":"List Task instances and latest Loop references","query":{"agent":"<optional claimant>","status":"<optional execution status>","limit":100}},
    {"id":"tasks.get","method":"GET","path":"/api/tasks/{task_id}","surface":"control-plane","description":"Read Task, all Loops, outputs, artifacts and comments"},
    {"id":"tasks.create","method":"POST","path":"/api/tasks","surface":"control-plane","write":true,"description":"Create a Task, optionally assigned to an Agent","body":{"input":"<self-contained instruction>","assignee":"<optional agent name>","created_by":"fleet-ops-01","source":"agent","parent_task_id":null}},
    {"id":"tasks.review_queue","method":"GET","path":"/api/review-queue","surface":"control-plane","description":"List Tasks awaiting delivery acceptance"},
    {"id":"tasks.comment","method":"POST","path":"/api/tasks/{task_id}/comments","surface":"control-plane","write":true,"description":"Comment on a Task or one of its Loops","body":{"author":"fleet-ops-01","content":"<comment>","loop_id":null}},
    {"id":"tasks.accept","method":"POST","path":"/api/tasks/{task_id}/accept","surface":"control-plane","write":true,"description":"Accept one Loop delivery, finish the Task and archive other Loops","body":{"loop_id":0,"author":"fleet-ops-01"}},
    {"id":"tasks.accept_reviewed","method":"POST","path":"/api/tasks/accept-reviewed","surface":"control-plane","write":true,"description":"Accept all currently reviewed Tasks in one call; returns accepted, skipped and remaining details","body":{"author":"fleet-ops-01"}},
    {"id":"tasks.close","method":"POST","path":"/api/tasks/{task_id}/close","surface":"control-plane","write":true,"description":"Close and void a Task without accepting a delivery","query":{"author":"fleet-ops-01"}},

    {"id":"loops.claim","method":"POST","path":"/api/tasks/{task_id}/loops","surface":"control-plane","write":true,"description":"Claim a Task as an Agent or human and create a Loop","body":{"claimant_type":"agent","claimant":"<agent name or human>","created_by":"fleet-ops-01"}},
    {"id":"loops.deliver","method":"POST","path":"/api/loops/{loop_id}/deliver","surface":"control-plane","write":true,"description":"Deliver a human or external Loop result for acceptance","body":{"content":"<delivery>","author":"fleet-ops-01"}},
    {"id":"loops.return","method":"POST","path":"/api/loops/{loop_id}/return","surface":"control-plane","write":true,"description":"Return a delivered Loop with comments and resume its Thread","body":{"comment":"<required corrections>","author":"fleet-ops-01"}},
    {"id":"loops.requeue","method":"POST","path":"/api/loops/{loop_id}/requeue","surface":"control-plane","write":true,"description":"Requeue a stale or returned agent Loop"},
    {"id":"loops.by_thread","method":"GET","path":"/api/loops/by-thread/{thread_id}","surface":"control-plane","description":"Resolve a Thread to its Loop and Task acceptance context"},

    {"id":"threads.list","method":"GET","path":"/api/console/fleet","surface":"console","description":"List Thread instances with runtime status and cost"},
    {"id":"threads.get","method":"GET","path":"/api/console/threads/{tid}","surface":"console","description":"Read Thread metadata, Runs and checkpoint count"},
    {"id":"threads.messages","method":"GET","path":"/api/console/threads/{tid}/messages","surface":"console","description":"Read the Thread conversation"},
    {"id":"threads.create","method":"POST","path":"/api/console/threads","surface":"console","write":true,"description":"Create a Thread and optionally run its first instruction","timeout_seconds":600,"body":{"assistant_id":"fleet-ops-01","instruction":"<optional first message>","recursion_limit":300}},
    {"id":"threads.send","method":"POST","path":"/api/console/threads/{tid}/messages","surface":"console","write":true,"description":"Send a message and resume an existing Thread","timeout_seconds":600,"body":{"content":"<message>","recursion_limit":300}},
    {"id":"threads.destroy","method":"DELETE","path":"/api/console/threads/{tid}","surface":"console","write":true,"description":"Destroy a Thread and all persisted state"},
    {"id":"threads.review_context","method":"GET","path":"/api/console/threads/{tid}/review-context","surface":"console","description":"Read acceptance context through the Console surface"},
    {"id":"threads.artifact","method":"GET","path":"/api/console/threads/{tid}/artifacts/{path}","surface":"console","confirmation":"human_only","description":"Download a binary or text artifact through its Console URL"},
    {"id":"threads.state","method":"GET","path":"/api/threads/{thread_id}/state","surface":"gateway","description":"Read the Gateway Thread checkpoint state"},
    {"id":"threads.token_usage","method":"GET","path":"/api/threads/{thread_id}/token-usage","surface":"gateway","description":"Read Gateway token usage for a Thread"},

    {"id":"runs.wait","method":"POST","path":"/api/runs/wait","surface":"gateway","write":true,"description":"Execute an Agent Run and wait for completion","timeout_seconds":600,"body":{"assistant_id":"<agent name>","input":{"messages":[{"role":"user","content":"<instruction>"}]},"config":{"configurable":{"thread_id":"<thread id>"}}}},
    {"id":"runs.stream","method":"POST","path":"/api/runs/stream","surface":"gateway","write":true,"description":"Execute an Agent Run with an SSE response","body":{"assistant_id":"<agent name>","input":{"messages":[{"role":"user","content":"<instruction>"}]},"config":{"configurable":{"thread_id":"<thread id>"}}}},
    {"id":"runs.get","method":"GET","path":"/api/threads/{thread_id}/runs/{run_id}","surface":"gateway","description":"Read a Run record"},
    {"id":"runs.messages","method":"GET","path":"/api/runs/{run_id}/messages","surface":"gateway","description":"Read paginated Run messages","query":{"limit":50,"before_seq":null,"after_seq":null}},
    {"id":"runs.events","method":"GET","path":"/api/threads/{thread_id}/runs/{run_id}/events","surface":"gateway","description":"Read Run events"},
    {"id":"runs.cancel","method":"POST","path":"/api/threads/{thread_id}/runs/{run_id}/cancel","surface":"gateway","write":true,"description":"Cancel a running Run"},
    {"id":"runs.feedback","method":"PUT","path":"/api/threads/{thread_id}/runs/{run_id}/feedback","surface":"gateway","write":true,"description":"Create or update the current principal's Run feedback","body":{"rating":1,"comment":"<optional feedback>"}},
    {"id":"runs.feedback_create","method":"POST","path":"/api/threads/{thread_id}/runs/{run_id}/feedback","surface":"gateway","write":true,"description":"Create Run feedback, optionally scoped to a message","body":{"rating":1,"comment":"<optional feedback>","message_id":null}},
    {"id":"runs.feedback_list","method":"GET","path":"/api/threads/{thread_id}/runs/{run_id}/feedback","surface":"gateway","description":"List Run feedback"},
    {"id":"runs.feedback_stats","method":"GET","path":"/api/threads/{thread_id}/runs/{run_id}/feedback/stats","surface":"gateway","description":"Read aggregated Run feedback"},
    {"id":"runs.feedback_delete","method":"DELETE","path":"/api/threads/{thread_id}/runs/{run_id}/feedback","surface":"gateway","write":true,"description":"Delete the current principal's Run feedback"},
    {"id":"runs.feedback_delete_by_id","method":"DELETE","path":"/api/threads/{thread_id}/runs/{run_id}/feedback/{feedback_id}","surface":"gateway","write":true,"description":"Delete a Run feedback record by ID"},

    {"id":"scheduler.sync","method":"POST","path":"/api/scheduler/sync","surface":"control-plane","write":true,"description":"Reconcile YAML cron definitions and dispatch due Tasks"},
    {"id":"mcp.list","method":"GET","path":"/api/mcp-servers","surface":"control-plane","description":"List MCP server registrations without secret values"},
    {"id":"mcp.create","method":"POST","path":"/api/mcp-servers","surface":"control-plane","write":true,"secret_fields":["secrets"],"description":"Register an MCP server; non-empty secrets are human-only","body":{"name":"<server name>","command":"<executable>","args":[],"env":{},"secrets":{},"description":"","enabled":true,"actor":"fleet-ops-01"}},
    {"id":"mcp.update","method":"PUT","path":"/api/mcp-servers/{name}","surface":"control-plane","write":true,"secret_fields":["secrets"],"description":"Update an MCP server; non-empty secrets are human-only","body":{"name":"<server name>","command":"<executable>","args":[],"env":{},"secrets":{},"description":"","enabled":true,"actor":"fleet-ops-01"}},
    {"id":"mcp.destroy","method":"DELETE","path":"/api/mcp-servers/{name}","surface":"control-plane","write":true,"description":"Delete an MCP server registration and its stored secret reference","query":{"actor":"fleet-ops-01"}},
    {"id":"mcp.render","method":"POST","path":"/api/mcp-servers/render","surface":"control-plane","write":true,"description":"Render MCP configuration and reset the Gateway cache","query":{"actor":"fleet-ops-01"}},
    {"id":"templates.list","method":"GET","path":"/api/templates","surface":"control-plane","description":"List Agent definition templates"},
    {"id":"templates.render","method":"POST","path":"/api/templates/render","surface":"control-plane","write":true,"description":"Render an Agent YAML template without deploying it","query":{"actor":"fleet-ops-01"},"body":{"templateId":"website-reader","name":"<agent-name>","displayName":"","owner":"","costCenter":"","egressDomain":""}},

    {"id":"pats.list","method":"GET","path":"/api/pats","surface":"control-plane","description":"List PAT metadata without token values"},
    {"id":"pats.issue","method":"POST","path":"/api/pats","surface":"control-plane","confirmation":"human_only","description":"Issue a PAT in Settings; its one-time token must not enter the Thread","body":{"name":"<credential name>","scopes":["read"],"expires_in_days":null}},
    {"id":"pats.revoke","method":"DELETE","path":"/api/pats/{pat_id}","surface":"control-plane","write":true,"description":"Revoke a PAT by ID","query":{"author":"fleet-ops-01"}},
    {"id":"ops.credential_status","method":"GET","path":"/api/ops/credential","surface":"control-plane","description":"Read system Fleet Ops credential status without secrets"},
    {"id":"ops.credential_rotate","method":"POST","path":"/api/ops/credential/rotate","surface":"control-plane","confirmation":"human_only","description":"Rotate the system Fleet Ops PAT in Settings without revealing the token"}
  ]
}
